{
  "name": "ask-bill",
  "private": true,
  "version": "0.1.0-scaffold",
  "type": "module",
  "description": "Ask Bill versioned legislation reader, grounded conversation and private publisher application",
  "packageManager": "pnpm@10.18.1",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "10.18.1"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "registry:validate": "node scripts/validate-pr-registry.mjs",
    "ready": "node scripts/ready-work.mjs",
    "lint": "node scripts/lint.mjs",
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "typecheck": "pnpm run build && pnpm -r --workspace-concurrency=1 run typecheck",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm registry:validate && pnpm check",
    "preview": "pnpm --filter @ask-bill/web preview",
    "dev": "node apps/web/application/start.mjs --demo",
    "start": "node apps/web/application/start.mjs",
    "worker": "node apps/worker/application.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:check": "node scripts/migrate.mjs --check",
    "db:bootstrap": "node scripts/bootstrap-publisher.mjs",
    "preview:export": "node scripts/export-offline-preview.mjs",
    "assets:validate": "node tools/assets/verify.mjs"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
