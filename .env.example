# Public values; use separate private environment variables in production.
ASK_BILL_PUBLIC_ORIGIN=http://127.0.0.1:4100
ASK_BILL_ALLOW_LIVE_AI=false
ASK_BILL_ALLOW_VOICE=false
# Optional local backends. Do not put real credentials in this file.
# ASK_BILL_DATABASE_URL=postgresql://askbill:<local-password>@127.0.0.1:5432/askbill
# ASK_BILL_STORAGE_URL=http://127.0.0.1:9000
# ASK_BILL_LLM_API_KEY=
# ASK_BILL_TTS_API_KEY=
# ASK_BILL_PROVIDER_DATA_PROTECTION=verified
