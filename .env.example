# Local development example. Never commit a populated secret file.
ASK_BILL_STAGE=development
ASK_BILL_PUBLIC_ORIGIN=http://127.0.0.1:4100
# Explicit --demo supplies its own synthetic publisher. Hosted mode needs a real UUID.
# ASK_BILL_PUBLISHER_ID=
# ASK_BILL_DATABASE_URL=postgresql://ask_bill_runtime:PRIVATE_PASSWORD@127.0.0.1:5432/askbill
# ASK_BILL_SESSION_ENCRYPTION_KEY=32_RANDOM_BYTES_IN_STANDARD_BASE64
ASK_BILL_ALLOW_LIVE_AI=false
ASK_BILL_ALLOW_VOICE=false
ASK_BILL_ALLOW_TRANSCRIPTION=false
ASK_BILL_ALLOW_PUBLISHING=false
ASK_BILL_ALLOW_OFFICIAL_IMPORTS=false
ASK_BILL_SESSION_REQUEST_LIMIT=60
ASK_BILL_DAILY_REQUEST_LIMIT=1000
ASK_BILL_MAX_GENERATIONS=25

# AI generation and review use separately configured models with structured output.
# ASK_BILL_LLM_API_KEY=
# ASK_BILL_LLM_MODEL=
# ASK_BILL_REVIEW_MODEL=
# ASK_BILL_PROVIDER_DATA_PROTECTION=verified

# Optional synthetic speech and adult, explicitly submitted microphone recordings.
# ASK_BILL_TTS_API_KEY=
# ASK_BILL_TTS_MODEL=gpt-4o-mini-tts
# ASK_BILL_VOICE_ID=alloy
# ASK_BILL_VOICE_RIGHTS=verified
# ASK_BILL_STT_API_KEY=
# ASK_BILL_STT_MODEL=gpt-4o-mini-transcribe
# ASK_BILL_FFMPEG_PATH=/usr/bin/ffmpeg

# HTTPS private S3-compatible storage, shared by web publisher routes and the worker.
# ASK_BILL_STORAGE_URL=
# ASK_BILL_STORAGE_REGION=auto
# ASK_BILL_STORAGE_BUCKET=
# ASK_BILL_STORAGE_QUARANTINE_BUCKET=
# ASK_BILL_STORAGE_SOURCE_BUCKET=
# ASK_BILL_STORAGE_ACCESS_KEY_ID=
# ASK_BILL_STORAGE_SECRET_ACCESS_KEY=
# ASK_BILL_STORAGE_SESSION_TOKEN=
# ASK_BILL_STORAGE_PATH_STYLE=true

# Web publisher identity. Enroll an exact issuer/subject through db:bootstrap first.
# ASK_BILL_OIDC_ISSUER=
# ASK_BILL_OIDC_CLIENT_ID=
# ASK_BILL_OIDC_CLIENT_SECRET=
# ASK_BILL_OIDC_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_basic
# ASK_BILL_OIDC_MFA_AMR=mfa
# ASK_BILL_OIDC_MFA_ACR=
# ASK_BILL_OIDC_ALLOWED_ENDPOINT_ORIGINS=
# ASK_BILL_CONGRESS_API_KEY=

# Worker only. A passing isolation probe is required in hosted environments.
# ASK_BILL_SOURCE_SANDBOX_COMMAND=/opt/ask-bill/infra/run-source-sandbox.sh
# ASK_BILL_SOURCE_SANDBOX_VERIFIED=verified
# ASK_BILL_SOURCE_EXTRACTION_TIMEOUT_MS=120000
# ASK_BILL_WORKER_POLL_MS=1000
# ASK_BILL_WORKER_LEASE_SECONDS=120

# One-time owner CLI only: never attach these values to web or worker services.
# ASK_BILL_MIGRATION_DATABASE_URL=
# ASK_BILL_PUBLISHER_SLUG=
# ASK_BILL_PUBLISHER_NAME=
# ASK_BILL_OWNER_USER_ID=
# ASK_BILL_OWNER_OIDC_SUBJECT=
# ASK_BILL_RUNTIME_DB_ROLE=ask_bill_runtime
# ASK_BILL_RUNTIME_DB_PASSWORD=
